# Example environment variables for VitalSync

# For client-side (Vite). Prefix must be VITE_ to be exposed to the browser.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# For server / local test scripts
GEMINI_API_KEY=your_gemini_api_key_here
 
# Optional: route client requests through the local backend proxy instead of calling the API directly
# Set to `true` to have the client POST to `VITE_BACKEND_URL` (e.g. http://localhost:5000/api)
VITE_USE_BACKEND=false
# Optional override for backend URL
VITE_BACKEND_URL=http://localhost:5000/api
